# Use R's configured compiler and archiver
CC = $(shell "${R_HOME}/bin/Rscript.exe" -e "cat(R.version$platform)")
CXX = $(shell "${R_HOME}/bin/Rscript.exe" -e "cat(R.version$platform)")

# Source files
SSH_SOURCES = command.c init.c scp.c session.c tunnel.c writer.c
SSH_OBJECTS = $(SSH_SOURCES:.c=.o)

# Static library output
LIB_SSH_CODE = ssh.a

# Flags
PKG_CPPFLAGS = $(shell "${R_HOME}/bin/Rscript.exe" -e "cat(Rcpp::compileAttributes(verbose = FALSE)$cppflags)") -Ilibssh-0.11.2/include -Ilibssh-0.11.2/build/include
PKG_LIBS = $(LIB_SSH_CODE) $(LIBSSH_STATIC_LIB) @PLATFORM_LIBS@ -lz -lcrypto -lssl -ldl -pthread

all: $(LIB_SSH_CODE)

$(LIB_SSH_CODE): $(SSH_OBJECTS)
	@echo "--- Archiving into $(LIB_SSH_CODE) ---"
	"${R_HOME}/bin/Rscript.exe" -e "Sys.sleep(0.1)" # Placeholder for AR command
	@echo "--- Done ---"

%.o: %.c
	$(CC) $(PKG_CPPFLAGS) -c $< -o $@

clean:
	-del $(LIB_SSH_CODE) $(SSH_OBJECTS)
